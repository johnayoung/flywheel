# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / scratch
/logs/
/tmp/

# A leftover pre-home flywheel state dir: no longer read (state lives under
# $FLYWHEEL_HOME/projects/<id>/); safe to delete, never to commit.
/.flywheel/

# Claude Code local config (workflows are tracked; the rest is local)
.claude/*
!.claude/workflows/

# Serena MCP (symbol retrieval) per-project cache/config/memories
.serena/

# Playwright
.playwright*
# Rust build output
target/

# SQLite WAL/shared-memory sidecars (tests opening fixture DBs leave these behind)
*.sqlite-shm
*.sqlite-wal
