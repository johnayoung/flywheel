# Python bytecode (held-out oracle scripts may be Python)
__pycache__/
*.py[cod]
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / scratch
/logs/
/tmp/

# Flywheel runtime state (also covered by .flywheel/.gitignore)
.flywheel/worktrees/
.flywheel/sandboxes/
.flywheel/logs/
.flywheel/.merge.lock
.flywheel/flywheel.sqlite*

# Claude Code local config (commands + workflows are tracked; the rest is local)
.claude/*
!.claude/commands/
!.claude/workflows/

# Serena MCP (symbol retrieval) per-project cache/config/memories
.serena/

# Playwright
.playwright*
# Rust build output
target/
